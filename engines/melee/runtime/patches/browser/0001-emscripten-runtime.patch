+  result.stickX = sticks; result.stickY = sticks >> 8;
+  result.substickX = sticks >> 16; result.substickY = sticks >> 24;
+  result.triggerLeft = triggers; result.triggerRight = triggers >> 8;
+  result.analogA = (buttons & PAD_BUTTON_A) ? 255 : 0;
+  result.analogB = (buttons & PAD_BUTTON_B) ? 255 : 0;
+  return result;
+#else
   return static_cast<GCPad*>(s_config.GetController(pad_num))->GetInput();
+#endif
 }
 
 ControllerEmu::ControlGroup* GetGroup(int pad_num, PadGroup group)
