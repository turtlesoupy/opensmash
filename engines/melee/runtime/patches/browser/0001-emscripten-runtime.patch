diff --git a/vendor/dolphin/Source/Core/Common/MemArenaEmscripten.cpp b/vendor/dolphin/Source/Core/Common/MemArenaEmscripten.cpp
new file mode 100644
--- /dev/null
+++ b/vendor/dolphin/Source/Core/Common/MemArenaEmscripten.cpp
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// The static CPU core uses page tables, so its RAM needs no host virtual aliases.
+#include "Common/MemArena.h"
+#include <cstdlib>
+#include <cstring>
+#include "Common/Assert.h"
+
+namespace Common
+{
+MemArena::MemArena() = default;
+MemArena::~MemArena() { ReleaseSHMSegment(); }
+void MemArena::GrabSHMSegment(size_t size, std::string_view)
+{
+  ASSERT(!m_wasm_storage);
+  m_wasm_storage = static_cast<u8*>(std::calloc(1, size));
+  m_wasm_size = m_wasm_storage ? size : 0;
+}
+void MemArena::ReleaseSHMSegment()
+{
+  std::free(m_wasm_storage);
+  m_wasm_storage = nullptr;
+  m_wasm_size = 0;
+}
+void* MemArena::CreateView(s64 offset, size_t size)
+{
+  if (!m_wasm_storage || offset < 0 || static_cast<u64>(offset) > m_wasm_size ||
+      size > m_wasm_size - static_cast<size_t>(offset))
+    return nullptr;
+  return m_wasm_storage + offset;
+}
+void MemArena::ReleaseView(void*, size_t) {}
+// JIT fastmem explicitly remains unavailable in WebAssembly.
+u8* MemArena::ReserveMemoryRegion(size_t) { return nullptr; }
+void MemArena::ReleaseMemoryRegion() {}
+void* MemArena::MapInMemoryRegion(s64, size_t, void*, bool) { return nullptr; }
+bool MemArena::ChangeMappingProtection(void*, size_t, bool) { return false; }
+void MemArena::UnmapFromMemoryRegion(void*, size_t) {}
+size_t MemArena::GetPageSize() const { return 65536; }
+
+LazyMemoryRegion::LazyMemoryRegion() = default;
+LazyMemoryRegion::~LazyMemoryRegion() { Release(); }
+void* LazyMemoryRegion::Create(size_t size)
+{
+  ASSERT(!m_memory);
+  m_memory = std::calloc(1, size);
+  m_size = m_memory ? size : 0;
+  return m_memory;
+}
+void LazyMemoryRegion::Clear()
+{
+  if (m_memory) std::memset(m_memory, 0, m_size);
+}
+void LazyMemoryRegion::Release()
+{
+  std::free(m_memory);
+  m_memory = nullptr;
+  m_size = 0;
+}
+} // namespace Common
