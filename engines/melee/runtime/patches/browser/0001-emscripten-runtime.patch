diff --git a/vendor/dolphin/Source/Core/Common/GL/GLInterface/WebGL.h b/vendor/dolphin/Source/Core/Common/GL/GLInterface/WebGL.h
new file mode 100644
--- /dev/null
+++ b/vendor/dolphin/Source/Core/Common/GL/GLInterface/WebGL.h
@@ -0,0 +1,95 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <cstdio>
+#include "Common/GL/GLContext.h"
+#include <emscripten.h>
+#include <emscripten/html5.h>
+#include <emscripten/html5_webgl.h>
+
+class GLContextWebGL final : public GLContext
+{
+  EMSCRIPTEN_WEBGL_CONTEXT_HANDLE m_context = 0;
+  static inline thread_local EMSCRIPTEN_WEBGL_CONTEXT_HANDLE s_canvas_context = 0;
+  const char* m_selector = "#canvas";
+public:
+  static inline thread_local bool probe = false;
+  ~GLContextWebGL() override
+  {
+    // The probe and renderer each own a canvas and context. Terminating the
+    // runtime worker releases both; no native window is created.
+  }
+  bool IsHeadless() const override { return false; }
+  bool MakeCurrent() override
+  {
+    return emscripten_webgl_make_context_current(m_context) == EMSCRIPTEN_RESULT_SUCCESS;
+  }
+  bool ClearCurrent() override
+  {
+    return emscripten_webgl_make_context_current(0) == EMSCRIPTEN_RESULT_SUCCESS;
+  }
+  void Swap() override {
+    EM_ASM({ Module.swapStart = performance.now(); });
+    emscripten_webgl_commit_frame();
+    EM_ASM({
+      const committed = performance.now();
+      const bitmap = GLctx.canvas.transferToImageBitmap();
+      if (!(Module.swapCount++ % 60) || !Module.swapCount) {
+        Module.swapCount = Module.swapCount || 1;
+        err("[opensmash] present commit_ms=" + (committed-Module.swapStart) + " bitmap_ms=" + (performance.now()-committed));
+      }
+      postMessage(({cmd: 'opensmash-frame', bitmap: bitmap}), [bitmap]);
+    });
+  }
+  void Update() override
+  {
+    int width = 960, height = 720;
+    emscripten_get_canvas_element_size(m_selector, &width, &height);
+    m_backbuffer_width = width;
+    m_backbuffer_height = height;
+  }
+  void* GetFuncAddress(const std::string& name) override
+  {
+    return emscripten_webgl_get_proc_address(name.c_str());
+  }
+protected:
+  bool Initialize(const WindowSystemInfo&, bool stereo, bool) override
+  {
+    if (stereo) return false;
+    if (probe) {
+      m_selector = "#opensmash-probe";
+      EM_ASM({
+        GL.offscreenCanvases["opensmash-probe"] = ({
+          offscreenCanvas: new OffscreenCanvas(16, 16), id: "opensmash-probe"
+        });
+      });
+    }
+    if (!probe && s_canvas_context) {
+      m_context = s_canvas_context;
+      m_opengl_mode = Mode::OpenGLES;
+      Update();
+      return MakeCurrent();
+    }
+    EmscriptenWebGLContextAttributes attributes;
+    emscripten_webgl_init_context_attributes(&attributes);
+    attributes.majorVersion = 2;
+    attributes.minorVersion = 0;
+    attributes.alpha = false;
+    attributes.antialias = false;
+    attributes.explicitSwapControl = true;
+    attributes.proxyContextToMainThread = EMSCRIPTEN_WEBGL_CONTEXT_PROXY_DISALLOW;
+    attributes.renderViaOffscreenBackBuffer = true;
+    m_context = emscripten_webgl_create_context(m_selector, &attributes);
+    std::fprintf(stderr, "[opensmash] WebGL context %lu\n", static_cast<unsigned long>(m_context));
+    if (m_context <= 0 || !MakeCurrent()) return false;
+    if (!probe) {
+      s_canvas_context = m_context;
+      EM_ASM({
+        const ext = GLctx.getExtension('WEBGL_debug_renderer_info');
+        err('[opensmash] GPU ' + (ext ? GLctx.getParameter(ext.UNMASKED_RENDERER_WEBGL) : 'unavailable'));
+      });
+    }
+    m_opengl_mode = Mode::OpenGLES;
+    Update();
+    return true;
+  }
+};
