+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <array>
+#include <mutex>
+#include <emscripten.h>
+#include "AudioCommon/SoundStream.h"
+namespace {
+std::mutex browser_audio_mutex;
+Mixer* browser_audio_mixer = nullptr;
+bool browser_audio_running = false;
+class BrowserSoundStream final : public SoundStream {
+public:
+  bool Init() override {
+    std::lock_guard lock(browser_audio_mutex);
+    browser_audio_mixer = GetMixer();
+    return true;
+  }
+  bool SetRunning(bool running) override {
+    std::lock_guard lock(browser_audio_mutex);
+    browser_audio_running = running;
+    return true;
+  }
+  ~BrowserSoundStream() override {
+    std::lock_guard lock(browser_audio_mutex);
+    browser_audio_mixer = nullptr;
+    browser_audio_running = false;
+  }
+};
+}
+extern "C" EMSCRIPTEN_KEEPALIVE const short* opensmash_audio_mix() {
+  static std::array<short, 1024> samples;
+  std::lock_guard lock(browser_audio_mutex);
+  if (browser_audio_mixer && browser_audio_running)
+    browser_audio_mixer->Mix(samples.data(), 512);
+  else
+    samples.fill(0);
+  return samples.data();
+}
