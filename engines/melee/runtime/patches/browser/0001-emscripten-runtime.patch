 std::optional<std::string> HashFileSha256(const std::filesystem::path& path)
 {
+#ifdef __EMSCRIPTEN__
+  std::ifstream file(path, std::ios::binary);
+  if (!file) return std::nullopt;
+  mbedtls_sha256_context context;
+  mbedtls_sha256_init(&context);
+  int error = mbedtls_sha256_starts_ret(&context, 0);
+  std::array<unsigned char, 65536> bytes;
+  while (!error && file) {
+    file.read(reinterpret_cast<char*>(bytes.data()), bytes.size());
+    const auto count = file.gcount();
+    if (count) error = mbedtls_sha256_update_ret(&context, bytes.data(), count);
+  }
+  unsigned char hash[32];
+  if (!error && file.eof()) error = mbedtls_sha256_finish_ret(&context, hash);
+  else error = -1;
+  mbedtls_sha256_free(&context);
+  if (error) return std::nullopt;
+  std::ostringstream out;
+  out << std::hex << std::setfill('0');
+  for (auto byte : hash) out << std::setw(2) << unsigned(byte);
+  return out.str();
+#else
   auto bytes = ReadFile(path);
   if (!bytes)
     return std::nullopt;
   return Sha256(std::move(*bytes));
+#endif
 }
 
 std::optional<std::string> HashDirectorySha256(const std::filesystem::path& root)
 {
+#ifdef __EMSCRIPTEN__
+  // The browser launcher has already verified the whole source disc. This is
+  // a cache identity, including any costume override, not a second integrity gate.
+  // Avoid eagerly fetching and retaining unused movie files in the lazy FS.
+  if (root == "/game/files") {
+    const char* identity = std::getenv("OPENSMASH_VERIFIED_ASSET_IDENTITY");
+    if (identity && std::strlen(identity) == 64 &&
+        std::all_of(identity, identity + 64, [](char c) {
+          return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+        })) return std::string(identity);
+  }
+#endif
   std::error_code ec;
   if (!std::filesystem::is_directory(root, ec) || ec)
     return std::nullopt;
diff --git a/vendor/dolphin/GXRuntime/include/core/browser_fma.h b/vendor/dolphin/GXRuntime/include/core/browser_fma.h
new file mode 100644
--- /dev/null
+++ b/vendor/dolphin/GXRuntime/include/core/browser_fma.h
@@ -0,0 +1,15 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <math.h>
+// A product of two finite binary32 values is exact in binary64 (48 significant
+// bits, with ample exponent range). Only the addition rounds, exactly as fma.
+// This avoids Wasm's software binary64 fma for common skinning operands. The
+// existing PPC rounding correction, FPSCR and exceptional-value paths remain.
+static inline double opensmash_exact_fma(double a, double c, double b) {
+#ifdef __EMSCRIPTEN__
+    if (isfinite(a) && isfinite(c) && isfinite(b) &&
+        (double)(float)a == a && (double)(float)c == c)
+        return a * c + b;
+#endif
+    return fma(a, c, b);
+}
