+
+// The run loop must observe idle-loop addresses to skip idle time.
+static void ChainStopAt(u32 address)
+{
+  const u32 offset = address - 0x80000000u;
+  if (opensmash_chain_hook_bits && address != 0 && offset < 0x00400000u && !(offset & 3u))
+    opensmash_chain_hook_bits[offset >> 8] |= u64{1} << ((offset >> 2) & 63u);
+}
+
+bool StaticRecompCore::ChainTablesMatch()
+{
+  if (m_chain_tables_state == 0)
+  {
+    bool match = m_module && opensmash_chain_chunk_count == m_module->num_chunk_ranges;
+    for (u32 i = 0; match && i < opensmash_chain_chunk_count; ++i)
+      match = opensmash_chain_chunk_base[i] == m_module->chunk_ranges[i].start;
+    m_chain_tables_state = match ? 1 : -1;
+    if (!match)
+      std::fprintf(stderr, "[staticrecomp] region chaining disabled: table mismatch\n");
+    // Regions the chassis interprets (host-call regions) are never chained into.
+    m_chain_forced_chunks.assign(m_module ? m_module->num_chunk_ranges : 0, 0);
+    for (u32 i = 0; match && i < m_module->num_chunk_ranges; ++i)
+    {
+      const auto& chunk = m_module->chunk_ranges[i];
+      for (const StaticRecompRange& range : m_forced_fallback_ranges)
+        if (range.start < chunk.end && chunk.start < range.end)
+          m_chain_forced_chunks[i] = 1;
+    }
+  }
+  return m_chain_tables_state == 1;
+}
