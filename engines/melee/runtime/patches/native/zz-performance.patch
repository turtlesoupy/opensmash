 std::optional<std::string> HashFileSha256(const std::filesystem::path& path)
 {
+#ifdef _WIN32
+  // Stream large movies and assets through the platform SHA-256 implementation.
+  // The digest remains identical; no file is skipped or trusted from a cache.
+  struct Provider {
+    BCRYPT_ALG_HANDLE handle = nullptr;
+    Provider() { BCryptOpenAlgorithmProvider(&handle, BCRYPT_SHA256_ALGORITHM, nullptr, 0); }
+    ~Provider() { if (handle) BCryptCloseAlgorithmProvider(handle, 0); }
+  };
+  static const Provider provider;
+  if (!provider.handle)
+    return std::nullopt;
+  struct Hash {
+    BCRYPT_HASH_HANDLE handle = nullptr;
+    ~Hash() { if (handle) BCryptDestroyHash(handle); }
+  } hash;
+  if (BCryptCreateHash(provider.handle, &hash.handle, nullptr, 0, nullptr, 0, 0) < 0)
+    return std::nullopt;
+  std::ifstream file(path, std::ios::binary);
+  if (!file)
+    return std::nullopt;
+  std::array<unsigned char, 65536> buffer;
+  while (file) {
+    file.read(reinterpret_cast<char*>(buffer.data()), buffer.size());
+    const auto count = file.gcount();
+    if (count > 0 && BCryptHashData(hash.handle, buffer.data(), static_cast<ULONG>(count), 0) < 0)
+      return std::nullopt;
+  }
+  if (file.bad() || !file.eof())
+    return std::nullopt;
+  std::array<unsigned char, 32> digest;
+  if (BCryptFinishHash(hash.handle, digest.data(), static_cast<ULONG>(digest.size()), 0) < 0)
+    return std::nullopt;
+  std::ostringstream out;
+  out << std::hex << std::setfill('0');
+  for (const auto byte : digest)
+    out << std::setw(2) << unsigned(byte);
+  return out.str();
+#else
   auto bytes = ReadFile(path);
   if (!bytes)
     return std::nullopt;
   return Sha256(std::move(*bytes));
+#endif
 }
 
