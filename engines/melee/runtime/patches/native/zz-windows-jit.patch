 bool ModManager::HandlesAddress(std::uint32_t address) const {
+  // The JIT probes before entering a block, unlike the module dispatcher,
+  // which calls Dispatch unconditionally. Deliver startup events before the
+  // first guest instruction even when that address has no explicit hook.
+  if (!m_impl->runtime_started && !m_impl->loaded.empty())
+    return true;
   if (m_impl->MayHaveStaticAddress(address) &&
       (m_impl->patches.contains(address) || m_impl->hooks.contains(address)))
     return true;
