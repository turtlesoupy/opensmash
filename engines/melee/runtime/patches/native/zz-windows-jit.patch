+// Select the desktop execution engine without changing netplay or lockstep.
+#pragma once
+#include <string_view>
+
+constexpr bool UseJitForNativeGame(bool windows, bool available, bool netplay,
+                                   bool lockstep, std::string_view preference)
+{
+  if (!available || netplay || lockstep)
+    return false;
+  if (!preference.empty())
+    return preference == "jit";
+  return windows;
+}
+
+// Optimizer bailouts must update the engine that will recompile the block.
+template <typename Core>
+constexpr Core* SelectJitProfilingTarget(Core* registered, Core* outer, Core* fallback)
+{
+  return registered == outer && fallback ? fallback : registered;
+}
